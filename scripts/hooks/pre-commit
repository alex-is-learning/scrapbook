#!/usr/bin/env bash
# Pre-commit hook: block contact-detail leaks, then update content word count
set -euo pipefail

# Run from the repository root
ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$ROOT" ]; then
  cd "$ROOT"
fi

# Refuse the commit if it would publish someone's phone/email
bash scripts/pii-guard.sh

# Run the update script
bash scripts/update-wordcount.sh

# If the update script exits non-zero, the commit will abort due to 'set -e'
exit 0
